{
  "name": "@gcode/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Main CLI application for G Code",
  "bin": {
    "gcode": "./dist/gcode.cjs",
    "gcode": "./dist/gcode.cjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/gcode.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:desktop-agent": "node scripts/build.mjs --desktop-agent",
    "build:sea": "pnpm --dir ../../../.. exec turbo --skip-infer --cwd apps/gcode-cli run build --filter=!@gcode/cli --force && pnpm build && node scripts/build-sea.mjs --all",
    "sea": "node scripts/build-sea.mjs",
    "upload:sea": "node scripts/upload-sea-smb.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "lint:fix": "oxlint --write src"
  },
  "dependencies": {
    "@gcode/adapters": "workspace:*",
    "@gcode/bootstrap": "workspace:*",
    "@gcode/contracts": "workspace:*",
    "@gcode/core": "workspace:*",
    "@gcode/dynamic-workflow-runtime": "workspace:*",
    "@gcode/i18n": "workspace:*",
    "@gcode/provider-node": "workspace:*",
    "@gcode/shared": "workspace:*",
    "@gcode/shared-types": "workspace:*",
    "@gcode/tui": "workspace:*",
    "dotenv": "^17.4.2",
    "playwright-core": "1.59.1"
  }
}
